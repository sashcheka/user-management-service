LOCALSTACK_HOST=localstack
LOCALSTACK_PORT=4566
LOCALSTACK_AWS_ACCESS_KEY_ID=aws_access_key_id
LOCALSTACK_AWS_SECRET_ACCESS_KEY=aws_secret_access_key
LOCALSTACK_REGION_NAME=us-east-1
LOCALSTACK_BUCKET_NAME=my-local-bucket

RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=demo_db

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

AUTH_JWT_PRIVATE_KEY_PATH=core/certs/private_key.pem
AUTH_JWT_PUBLIC_KEY_PATH=core/certs/public_key.pem
AUTH_JWT_ALGORITHM=RS512
AUTH_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10
AUTH_JWT_REFRESH_TOKEN_EXPIRE_MINUTES=60

WEB_PORT=8000
